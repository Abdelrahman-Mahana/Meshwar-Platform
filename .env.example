# MASHWAR Qatar Pilot — Environment & Build Defines Example
# Copy to `.env` (never commit `.env`) and pass values via
# `flutter run --dart-define-from-file=.env` or explicit `--dart-define` flags.
#
# SECURITY: Never commit real API keys, service accounts, or production secrets.

# Target runtime flavor: development | staging | production
APP_ENV=development

# Enable Firebase Auth + Cloud Firestore repositories (true | false)
USE_FIREBASE=false

# Dev/test mock auth switch (ONLY honored when APP_ENV=development and USE_FIREBASE=false)
USE_DEV_MOCKS=false

# Firebase project metadata
FIREBASE_PROJECT_ID=mashwar-qatar-2026-ec99d
FIREBASE_REGION=europe-west1

# Platform Firebase client API keys (replace with project-restricted keys)
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_ANDROID_API_KEY=REPLACE_WITH_FIREBASE_ANDROID_API_KEY
FIREBASE_IOS_API_KEY=REPLACE_WITH_FIREBASE_IOS_API_KEY

# Google Maps SDK / Places / Directions key (restrict by bundle ID / HTTP referrer)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY
