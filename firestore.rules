        validString(data.id, 1, 128) &&
        validString(data.userId, 1, 128) &&
        validString(data.fromCity, 1, 100) &&
        validString(data.toCity, 1, 100) &&
        validString(data.dateRange, 1, 100) &&
        validString(data.category, 1, 50) &&
        data.isActive is bool &&
        data.isExpired is bool;
    }

    // Validator for wallet_transactions/{txId}
    function isValidWalletTransaction(data) {
      let allowed = [
        'id', 'userId', 'amount', 'type', 'method',
        'referenceNumber', 'status', 'titleAr', 'titleEn', 'timestamp', 'createdAt'
      ];
      let required = [
        'id', 'userId', 'amount', 'type', 'method',
        'referenceNumber', 'status', 'titleAr', 'titleEn'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, required) &&
        validString(data.id, 1, 128) &&
        validString(data.userId, 1, 128) &&
        data.amount is number &&
        data.type in ['deposit', 'withdraw', 'ridePayment', 'rideEarning', 'errandPayment', 'errandEarning', 'parcelPayment', 'parcelEarning'] &&
        data.method in ['vodafoneCash', 'instapay', 'fawry', 'creditCard', 'cash'] &&
        validString(data.referenceNumber, 1, 100) &&
        data.status in ['pending', 'success', 'failed', 'cancelled'] &&
        validString(data.titleAr, 1, 200) &&
        validString(data.titleEn, 1, 200);
    }

    // Validator for driver_verifications/{verificationId}
    function isValidDriverVerification(data) {
      let allowed = [
        'id', 'driverId', 'driverName', 'governorate', 'carModel',
        'carPlate', 'licenseExpiryDate', 'nationalId', 'licenseFrontImage',
        'licenseBackImage', 'carFrontImage', 'status', 'rejectionReason',
        'rejectionNote', 'submittedAt', 'updatedAt'
      ];
      let required = [
        'id', 'driverId', 'driverName', 'governorate', 'carModel',
        'carPlate', 'licenseExpiryDate', 'status'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, required) &&
        validString(data.id, 1, 128) &&
        validString(data.driverId, 1, 128) &&
        validString(data.driverName, 2, 100) &&
        validString(data.governorate, 1, 50) &&
        validString(data.carModel, 1, 100) &&
        validString(data.carPlate, 1, 50) &&
        validString(data.licenseExpiryDate, 1, 50) &&
        data.status in ['pending', 'underReview', 'accepted', 'rejected', 'قيد المراجعة', 'مقبولة', 'مرفوضة'] &&
        validOptionalString(data, 'nationalId', 14, 20) &&
        validOptionalUrl(data, 'licenseFrontImage') &&
        validOptionalUrl(data, 'licenseBackImage') &&
        validOptionalUrl(data, 'carFrontImage') &&
        validOptionalString(data, 'rejectionReason', 1, 500) &&
        validOptionalString(data, 'rejectionNote', 1, 500);
    }

    // Helper for conversation participant verification
    function isConversationParticipant(convId) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/conversations/$(convId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
        )
      );
    }

    // Helper for parcel access verification (sender, driver, receiver via uid or verified phone)
    function isParcelParty() {
      return isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        (resource.data.driverId != null && resource.data.driverId == request.auth.uid) ||
        ('receiverId' in resource.data && resource.data.receiverId == request.auth.uid) ||
        (
          request.auth.token.phone_number != null && (
            resource.data.receiverPhone == request.auth.token.phone_number ||
            request.auth.token.phone_number == "+2" + resource.data.receiverPhone ||
            request.auth.token.phone_number == "+20" + resource.data.receiverPhone
          )
        ) ||
        isAdmin()
      );
    }

    // Helper for escrow participant verification
    function isEscrowParticipant(data) {
      return isAuthenticated() && (
        ('requesterId' in data && data.requesterId == request.auth.uid) ||
        ('providerId' in data && data.providerId == request.auth.uid) ||
        ('payerId' in data && data.payerId == request.auth.uid) ||
        ('payeeId' in data && data.payeeId == request.auth.uid) ||
        ('participantIds' in data && data.participantIds is list && request.auth.uid in data.participantIds)
      );
    }

    // Helper for dispute party verification (complainant or respondent)
    function isDisputeParty(data) {
      return isAuthenticated() && (
        ('complainantId' in data && data.complainantId == request.auth.uid) ||
        ('respondentId' in data && data.respondentId == request.auth.uid)
      );
    }

    // Validator for platform_config/{configId}
    function isValidPlatformConfig(data) {
      let allowed = [
        'id', 'key', 'value', 'nameAr', 'nameEn', 'unitAr', 'unitEn',
        'descriptionAr', 'descriptionEn', 'broadcastBanner', 'bannerAr',
        'bannerEn', 'bannerActive', 'bannerType', 'maintenanceMode',
        'maintenanceMessageAr', 'maintenanceMessageEn', 'minAppVersion',
        'thresholds', 'isActive', 'updatedBy', 'createdAt', 'updatedAt'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        data.keys().size() >= 1 &&
        validOptionalString(data, 'id', 1, 128) &&
        validOptionalString(data, 'key', 1, 100) &&
        (!('value' in data) || data.value == null || (data.value is string && data.value.size() <= 500) || data.value is number || data.value is bool) &&
        validOptionalString(data, 'nameAr', 1, 150) &&
        validOptionalString(data, 'nameEn', 1, 150) &&
        validOptionalString(data, 'unitAr', 1, 30) &&
        validOptionalString(data, 'unitEn', 1, 30) &&
        validOptionalString(data, 'descriptionAr', 0, 500) &&
        validOptionalString(data, 'descriptionEn', 0, 500) &&
        validOptionalString(data, 'broadcastBanner', 0, 500) &&
        validOptionalString(data, 'bannerAr', 0, 500) &&
        validOptionalString(data, 'bannerEn', 0, 500) &&
        (!('bannerActive' in data) || data.bannerActive == null || data.bannerActive is bool) &&
        (!('bannerType' in data) || data.bannerType == null || data.bannerType in ['info', 'warning', 'alert', 'promo', 'maintenance']) &&
        (!('maintenanceMode' in data) || data.maintenanceMode == null || data.maintenanceMode is bool) &&
        validOptionalString(data, 'maintenanceMessageAr', 0, 500) &&
        validOptionalString(data, 'maintenanceMessageEn', 0, 500) &&
        validOptionalString(data, 'minAppVersion', 1, 30) &&
        (!('thresholds' in data) || data.thresholds == null || (data.thresholds is map && data.thresholds.keys().size() <= 50)) &&
        (!('isActive' in data) || data.isActive == null || data.isActive is bool) &&
        validOptionalString(data, 'updatedBy', 1, 128) &&
        validOptionalTimestamp(data, 'createdAt') &&
        validOptionalTimestamp(data, 'updatedAt');
    }

    // Validator for service_catalog/{serviceId}
    function isValidServiceCatalogItem(data) {
      let allowed = [
        'id', 'code', 'nameAr', 'nameEn', 'descriptionAr', 'descriptionEn',
        'category', 'iconName', 'iconUrl', 'baseFee', 'minPrice', 'maxPrice',
        'commissionPct', 'escrowRequired', 'requiresDriverVerification',
        'isActive', 'sortOrder', 'updatedBy', 'createdAt', 'updatedAt'
      ];
      let required = ['id', 'nameAr', 'nameEn', 'isActive'];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, required) &&
        validString(data.id, 1, 128) &&
        validString(data.nameAr, 1, 100) &&
        validString(data.nameEn, 1, 100) &&
        data.isActive is bool &&
        validOptionalString(data, 'code', 1, 64) &&
        validOptionalString(data, 'descriptionAr', 0, 500) &&
        validOptionalString(data, 'descriptionEn', 0, 500) &&
        validOptionalString(data, 'category', 1, 64) &&
        validOptionalString(data, 'iconName', 1, 64) &&
        validOptionalUrl(data, 'iconUrl') &&
        (!('baseFee' in data) || data.baseFee == null || (data.baseFee is number && data.baseFee >= 0 && data.baseFee <= 100000)) &&
        (!('minPrice' in data) || data.minPrice == null || (data.minPrice is number && data.minPrice >= 0 && data.minPrice <= 100000)) &&
        (!('maxPrice' in data) || data.maxPrice == null || (data.maxPrice is number && data.maxPrice >= 0 && data.maxPrice <= 100000)) &&
        (!('commissionPct' in data) || data.commissionPct == null || (data.commissionPct is number && data.commissionPct >= 0 && data.commissionPct <= 100)) &&
        (!('escrowRequired' in data) || data.escrowRequired == null || data.escrowRequired is bool) &&
        (!('requiresDriverVerification' in data) || data.requiresDriverVerification == null || data.requiresDriverVerification is bool) &&
        (!('sortOrder' in data) || data.sortOrder == null || (data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000)) &&
        validOptionalString(data, 'updatedBy', 1, 128) &&
        validOptionalTimestamp(data, 'createdAt') &&
        validOptionalTimestamp(data, 'updatedAt');
    }

    // Validator for corridors/{corridorId}
    function isValidCorridor(data) {
      let allowed = [
        'id', 'nameAr', 'nameEn', 'fromCity', 'toCity', 'governorate',
        'distanceKm', 'estimatedMinutes', 'suggestedPrice', 'minPrice',
        'maxPrice', 'parcelBaseFee', 'isActive', 'isPopular', 'sortOrder',
